{
  "name": "cloudys-gloss",
  "version": "0.1.15",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "icons:build": "node scripts/build-icons.mjs",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "update:firefox": "python3 scripts/update-firefox.py",
    "postinstall": "wxt prepare",
    "lint": "eslint .",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "test:quality": "vitest run --config tests/quality/vitest.config.ts",
    "test:quality:mlx": "python3 tests/quality/run-mlx.py",
    "quality:report": "python3 tests/quality/report.py",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "test:e2e": "pnpm build && pnpm build:firefox && playwright test",
    "smoke:live": "pnpm build && pnpm build:firefox && playwright test -c playwright.live.config.ts",
    "smoke:pdf": "pnpm build && pnpm build:firefox && playwright test -c playwright.pdf.config.ts",
    "model:mlx": "python3 scripts/mlx-service.py run",
    "model:install": "python3 scripts/mlx-service.py install",
    "model:start": "python3 scripts/mlx-service.py start",
    "model:stop": "python3 scripts/mlx-service.py stop",
    "model:status": "python3 scripts/mlx-service.py status",
    "model:uninstall": "python3 scripts/mlx-service.py uninstall",
    "model:bridge": "python3 scripts/native-host.py --install",
    "model:bridge:uninstall": "python3 scripts/native-host.py --uninstall",
    "test:native": "pnpm build && pnpm build:firefox && playwright test -c playwright.native.config.ts",
    "smoke:mlx": "MODEL_BASE_URL=http://127.0.0.1:8080/v1 MODEL_NAME=Qwen/Qwen3-1.7B-MLX-4bit pnpm smoke:live"
  },
  "dependencies": {
    "entities": "^8.1.0",
    "idb": "^8.0.3",
    "pdfjs-dist": "6.4.299",
    "preact": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3",
    "web-ext": "^10.7.0",
    "wxt": "^0.21.4"
  }
}
